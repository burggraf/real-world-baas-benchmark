email {}
server {
  application_name: "Bench TrailBase"
  logs_retention_sec: 604800
  enable_record_transactions: true
}
auth {
  auth_token_ttl_sec: 3600
  refresh_token_ttl_sec: 2592000
}
jobs {}

record_apis: {
  name: "profiles"
  table_name: "profiles"
  acl_authenticated: [CREATE, READ, UPDATE, DELETE]
  create_access_rule: "EXISTS(SELECT 1 FROM _user WHERE _user.id = _USER_.id AND _user.admin = TRUE)"
  read_access_rule: "_ROW_.authId = _USER_.id OR EXISTS(SELECT 1 FROM profiles JOIN memberships AS mine ON mine.userId = profiles.publicId JOIN memberships AS peer ON peer.organizationId = mine.organizationId WHERE profiles.authId = _USER_.id AND peer.userId = _ROW_.publicId) OR EXISTS(SELECT 1 FROM _user WHERE _user.id = _USER_.id AND _user.admin = TRUE)"
  update_access_rule: "(_ROW_.authId = _USER_.id AND 'displayName' IN _REQ_FIELDS_ AND (SELECT count(*) FROM _REQ_FIELDS_) = 1) OR EXISTS(SELECT 1 FROM _user WHERE _user.id = _USER_.id AND _user.admin = TRUE)"
  delete_access_rule: "EXISTS(SELECT 1 FROM _user WHERE _user.id = _USER_.id AND _user.admin = TRUE)"
}
record_apis: {
  name: "organizations"
  table_name: "organizations"
  acl_authenticated: [CREATE, READ, DELETE]
  create_access_rule: "EXISTS(SELECT 1 FROM _user WHERE _user.id = _USER_.id AND _user.admin = TRUE)"
  read_access_rule: "EXISTS(SELECT 1 FROM profiles JOIN memberships ON memberships.userId = profiles.publicId WHERE profiles.authId = _USER_.id AND memberships.organizationId = _ROW_.publicId) OR EXISTS(SELECT 1 FROM _user WHERE _user.id = _USER_.id AND _user.admin = TRUE)"
  delete_access_rule: "EXISTS(SELECT 1 FROM _user WHERE _user.id = _USER_.id AND _user.admin = TRUE)"
}
record_apis: {
  name: "memberships"
  table_name: "memberships"
  acl_authenticated: [CREATE, READ, UPDATE, DELETE]
  create_access_rule: "EXISTS(SELECT 1 FROM _user WHERE _user.id = _USER_.id AND _user.admin = TRUE)"
  read_access_rule: "EXISTS(SELECT 1 FROM profiles JOIN memberships AS mine ON mine.userId = profiles.publicId WHERE profiles.authId = _USER_.id AND mine.organizationId = _ROW_.organizationId) OR EXISTS(SELECT 1 FROM _user WHERE _user.id = _USER_.id AND _user.admin = TRUE)"
  update_access_rule: "('role' IN _REQ_FIELDS_ AND (SELECT count(*) FROM _REQ_FIELDS_) = 1 AND EXISTS(SELECT 1 FROM profiles JOIN memberships AS manager ON manager.userId = profiles.publicId WHERE profiles.authId = _USER_.id AND manager.organizationId = _ROW_.organizationId AND manager.role IN ('owner','admin'))) OR EXISTS(SELECT 1 FROM _user WHERE _user.id = _USER_.id AND _user.admin = TRUE)"
  delete_access_rule: "EXISTS(SELECT 1 FROM _user WHERE _user.id = _USER_.id AND _user.admin = TRUE)"
}
record_apis: {
  name: "projects"
  table_name: "projects"
  acl_authenticated: [CREATE, READ, DELETE]
  create_access_rule: "EXISTS(SELECT 1 FROM _user WHERE _user.id = _USER_.id AND _user.admin = TRUE)"
  read_access_rule: "EXISTS(SELECT 1 FROM profiles JOIN memberships ON memberships.userId = profiles.publicId WHERE profiles.authId = _USER_.id AND memberships.organizationId = _ROW_.organizationId) OR EXISTS(SELECT 1 FROM _user WHERE _user.id = _USER_.id AND _user.admin = TRUE)"
  delete_access_rule: "EXISTS(SELECT 1 FROM _user WHERE _user.id = _USER_.id AND _user.admin = TRUE)"
}
record_apis: {
  name: "tasks"
  table_name: "tasks"
  acl_authenticated: [CREATE, READ, UPDATE, DELETE]
  read_access_rule: "EXISTS(SELECT 1 FROM profiles JOIN memberships ON memberships.userId = profiles.publicId WHERE profiles.authId = _USER_.id AND memberships.organizationId = _ROW_.organizationId) OR EXISTS(SELECT 1 FROM _user WHERE _user.id = _USER_.id AND _user.admin = TRUE)"
  create_access_rule: "(NOT EXISTS(SELECT 1 FROM _REQ_FIELDS_ WHERE _ NOT IN ('publicId','organizationId','projectId','creatorId','assigneeId','title','description','status','priority','dueDate')) AND EXISTS(SELECT 1 FROM profiles JOIN memberships ON memberships.userId = profiles.publicId WHERE profiles.authId = _USER_.id AND profiles.publicId = _REQ_.creatorId AND memberships.organizationId = _REQ_.organizationId)) OR EXISTS(SELECT 1 FROM _user WHERE _user.id = _USER_.id AND _user.admin = TRUE)"
  update_access_rule: "('_activityActorId' IN _REQ_FIELDS_ AND NOT EXISTS(SELECT 1 FROM _REQ_FIELDS_ WHERE _ NOT IN ('assigneeId','title','description','status','priority','dueDate','updatedAt','_activityActorId')) AND EXISTS(SELECT 1 FROM profiles JOIN memberships ON memberships.userId = profiles.publicId WHERE profiles.authId = _USER_.id AND profiles.publicId = _REQ_._activityActorId AND memberships.organizationId = _ROW_.organizationId)) OR EXISTS(SELECT 1 FROM _user WHERE _user.id = _USER_.id AND _user.admin = TRUE)"
  delete_access_rule: "EXISTS(SELECT 1 FROM _user WHERE _user.id = _USER_.id AND _user.admin = TRUE)"
}
record_apis: {
  name: "comments"
  table_name: "comments"
  acl_authenticated: [CREATE, READ, UPDATE, DELETE]
  read_access_rule: "EXISTS(SELECT 1 FROM profiles JOIN memberships ON memberships.userId = profiles.publicId WHERE profiles.authId = _USER_.id AND memberships.organizationId = _ROW_.organizationId) OR EXISTS(SELECT 1 FROM _user WHERE _user.id = _USER_.id AND _user.admin = TRUE)"
  create_access_rule: "(NOT EXISTS(SELECT 1 FROM _REQ_FIELDS_ WHERE _ NOT IN ('publicId','organizationId','projectId','taskId','authorId','body')) AND EXISTS(SELECT 1 FROM profiles JOIN memberships ON memberships.userId = profiles.publicId WHERE profiles.authId = _USER_.id AND profiles.publicId = _REQ_.authorId AND memberships.organizationId = _REQ_.organizationId)) OR EXISTS(SELECT 1 FROM _user WHERE _user.id = _USER_.id AND _user.admin = TRUE)"
  update_access_rule: "('_activityActorId' IN _REQ_FIELDS_ AND NOT EXISTS(SELECT 1 FROM _REQ_FIELDS_ WHERE _ NOT IN ('body','updatedAt','_activityActorId')) AND EXISTS(SELECT 1 FROM profiles JOIN memberships ON memberships.userId = profiles.publicId WHERE profiles.authId = _USER_.id AND profiles.publicId = _REQ_._activityActorId AND memberships.organizationId = _ROW_.organizationId)) OR EXISTS(SELECT 1 FROM _user WHERE _user.id = _USER_.id AND _user.admin = TRUE)"
  delete_access_rule: "EXISTS(SELECT 1 FROM _user WHERE _user.id = _USER_.id AND _user.admin = TRUE)"
}
record_apis: {
  name: "activities"
  table_name: "activities"
  acl_authenticated: [CREATE, READ, DELETE]
  create_access_rule: "EXISTS(SELECT 1 FROM _user WHERE _user.id = _USER_.id AND _user.admin = TRUE)"
  read_access_rule: "EXISTS(SELECT 1 FROM profiles JOIN memberships ON memberships.userId = profiles.publicId WHERE profiles.authId = _USER_.id AND memberships.organizationId = _ROW_.organizationId) OR EXISTS(SELECT 1 FROM _user WHERE _user.id = _USER_.id AND _user.admin = TRUE)"
  delete_access_rule: "EXISTS(SELECT 1 FROM _user WHERE _user.id = _USER_.id AND _user.admin = TRUE)"
}
